rules_version = '2';
// Reglas MVP para partidas online (uso familiar, partidas efímeras).
// Requiere estar AUTENTICADO (login anónimo del cliente). Solo `matches/**` es
// accesible; todo lo demás queda denegado.
// TODO(endurecer): limitar por participantes/propietario del match.
service cloud.firestore {
  match /databases/{database}/documents {
    match /matches/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
